{
  "name": "scrawl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first open-source canvas for technical diagrams and visual thinking.",
  "license": "MIT",
  "author": "Sai Chandan Regonda",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level high",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @scrawl/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:performance": "vitest run packages/engine/test/performance.test.ts packages/editor/test/performance.test.ts",
    "release:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:e2e",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
