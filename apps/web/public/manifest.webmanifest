{
  "name": "Scrawl",
  "short_name": "Scrawl",
  "description": "A free, open-source, local-first visual canvas for diagrams, whiteboards, sketches, and visual thinking.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f6f4ee",
  "theme_color": "#f3efe4",
  "icons": [
    {
      "src": "/scrawl-logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/scrawl-logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/vnd.scrawl+json": [".scrawl"]
      }
    }
  ]
}
